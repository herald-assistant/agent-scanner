{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "newProjectRoot": "projects",
  "projects": {
    "agent-scanner-ui": {
      "projectType": "application",
      "root": "",
      "sourceRoot": "src",
      "prefix": "as",
      "architect": {
        "build": {
          "builder": "@angular/build:application",
          "options": {
          "browser": "src/main.ts",
          "tsConfig": "tsconfig.app.json",
          "inlineStyleLanguage": "css",
          "assets": [
            "src/favicon.svg"
          ],
          "outputPath": {
              "base": "../target/classes/static",
              "browser": ""
            },
            "index": "src/index.html",
            "styles": [
              "node_modules/@angular/material/prebuilt-themes/cyan-orange.css",
              "node_modules/material-symbols/outlined.css",
              "src/styles.css"
            ]
          },
          "configurations": {
            "production": {
              "budgets": [
                {"type": "initial", "maximumWarning": "750kB", "maximumError": "1MB"}
              ],
              "outputHashing": "all"
            },
            "development": {
              "optimization": false,
              "sourceMap": true
            }
          },
          "defaultConfiguration": "production"
        },
        "serve": {
          "builder": "@angular/build:dev-server",
          "configurations": {
            "production": {"buildTarget": "agent-scanner-ui:build:production"},
            "development": {"buildTarget": "agent-scanner-ui:build:development"}
          },
          "defaultConfiguration": "development"
        },
        "test": {
          "builder": "@angular/build:unit-test",
          "options": {
            "tsConfig": "tsconfig.spec.json"
          }
        }
      }
    }
  }
}
