{
  "name": "agent-scanner-ui",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "start": "ng serve --proxy-config proxy.conf.json",
    "check:styles": "node scripts/check-styles.mjs",
    "prebuild": "npm run prepare:assets && npm run check:styles",
    "build": "ng build",
    "test": "ng test --watch=false",
    "start:demo": "ng serve --configuration demo",
    "prebuild:demo": "npm run prepare:assets && npm run check:styles",
    "build:demo": "ng build --configuration demo",
    "pretest": "npm run prepare:assets && node scripts/prepare-test-fixtures.mjs",
    "prepare:assets": "node scripts/prepare-demo-assets.mjs",
    "prestart": "npm run prepare:assets",
    "prestart:demo": "npm run prepare:assets",
    "test:demo:e2e": "node --test e2e/demo.test.mjs"
  },
  "dependencies": {
    "@angular/cdk": "^22.1.4",
    "@angular/common": "^22.1.4",
    "@angular/compiler": "^22.1.4",
    "@angular/core": "^22.1.4",
    "@angular/material": "^22.1.4",
    "@angular/platform-browser": "^22.1.4",
    "@angular/router": "22.1.4",
    "dompurify": "^3.4.15",
    "marked": "^18.0.13",
    "material-symbols": "^0.47.0",
    "rxjs": "^7.8.2",
    "tslib": "^2.8.1"
  },
  "devDependencies": {
    "@angular/build": "^22.1.6",
    "@angular/cli": "^22.1.6",
    "@angular/compiler-cli": "^22.1.4",
    "jsdom": "^30.0.1",
    "playwright": "1.62.1",
    "typescript": "~6.0.3",
    "vitest": "^4.1.11"
  }
}
